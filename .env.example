# Site URL (canonical, SEO ve Analytics için)
NEXT_PUBLIC_SITE_URL=https://www.asialux.com.tr

# İletişim formu e-posta gönderimi (Gmail SMTP)
# Gmail için: Google Hesabı > Güvenlik > 2 Adımlı Doğrulama açık olmalı
# Ardından: Google Hesabı > Güvenlik > Uygulama şifreleri > "Uygulama şifresi oluştur"
# Oluşan 16 haneli şifreyi SMTP_PASS olarak kullanın (normal Gmail şifresi ÇALIŞMAZ)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
# Form mesajlarının gideceği adres (opsiyonel; boşsa SMTP_USER kullanılır)
CONTACT_EMAIL=bilgi@asialux.com.tr

# reCAPTCHA v3 - Spam koruması (https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key
RECAPTCHA_SECRET_KEY=your_secret_key
